# Theme & Font
theme = dark:Catppuccin Mocha,light:Catppuccin Latte
font-family = JetBrainsMono Nerd Font Mono
font-size = 12
adjust-cell-height = 2

# Shell
shell-integration = detect
shell-integration-features = ssh-terminfo,ssh-env
confirm-close-surface = false

# Window
maximize = true
window-padding-x = 8
window-padding-y = 8
background-opacity = 0.95
background-blur-radius = 20
unfocused-split-opacity = 0.85
macos-titlebar-style = transparent
window-save-state = always
window-theme = auto

# Working Dir
working-directory = home
window-inherit-working-directory = true

# Cursor
cursor-style = bar
cursor-style-blink = true
cursor-opacity = 0.8

# Behavior
copy-on-select = clipboard
auto-update = check
mouse-hide-while-typing = true

# Security
clipboard-paste-protection = true
clipboard-paste-bracketed-safe = true

# Performance
scrollback-limit = 1000000

# Quick terminal
keybind = global:cmd+shift+space=toggle_quick_terminal
quick-terminal-size = 80%
quick-terminal-position = top
quick-terminal-screen = mouse
quick-terminal-autohide = true
quick-terminal-animation-duration = 0.15

# Tabs
keybind = cmd+t=new_tab
keybind = cmd+shift+left=previous_tab
keybind = cmd+shift+right=next_tab
keybind = cmd+w=close_surface

# Splits
keybind = cmd+d=new_split:right
keybind = cmd+shift+d=new_split:down
keybind = cmd+opt+left=goto_split:left
keybind = cmd+opt+right=goto_split:right
keybind = cmd+opt+up=goto_split:top
keybind = cmd+opt+down=goto_split:bottom
keybind = cmd+opt+r=resize_split:up,10
keybind = cmd+opt+f=resize_split:down,10
keybind = cmd+opt+h=goto_split:left
keybind = cmd+opt+l=goto_split:right
keybind = cmd+opt+k=goto_split:top
keybind = cmd+opt+j=goto_split:bottom
keybind = cmd+ctrl+h=resize_split:left,10
keybind = cmd+ctrl+l=resize_split:right,10
keybind = cmd+ctrl+k=resize_split:up,10
keybind = cmd+ctrl+j=resize_split:down,10
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom

# Font size
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size

# Reload config
keybind = cmd+shift+comma=reload_config
