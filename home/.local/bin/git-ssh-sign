#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} != -Y || ${2:-} != sign ]]; then
  exec ssh-keygen "$@"
fi

op_sign=/Applications/1Password.app/Contents/MacOS/op-ssh-sign
op_socket="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
if [[ -x "$op_sign" && -S "$op_socket" ]]; then
  exec "$op_sign" "$@"
fi

fallback_key="$HOME/.ssh/git_signing_fallback_ed25519"
if [[ ! -f "$fallback_key" ]]; then
  echo "git-ssh-sign: 1Password is unavailable and $fallback_key is missing." >&2
  echo "Run setup-fallback-signing.sh to create a local signing key." >&2
  exit 1
fi

args=("$@")
key_option_found=0
for ((i = 0; i + 1 < ${#args[@]}; i++)); do
  if [[ ${args[i]} == -f ]]; then
    args[i + 1]=$fallback_key
    key_option_found=1
    break
  fi
done
if ((! key_option_found)); then
  echo 'git-ssh-sign: Git did not provide a signing key (-f).' >&2
  exit 1
fi

notice="git-ssh-sign: 1Password unavailable; signing with $fallback_key"
if ! { printf '%s\n' "$notice" >/dev/tty; } 2>/dev/null; then
  printf '%s\n' "$notice" >&2
fi
exec ssh-keygen "${args[@]}"
