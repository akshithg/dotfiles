#!/bin/zsh
# Only strict mode when executed, not when sourced (sourcing would poison the shell)
if [[ "${ZSH_EVAL_CONTEXT:-}" != *:file ]]; then
    set -euo pipefail
fi

# Detect appearance: macOS uses defaults, Linux defaults to dark
if [[ "$(uname -s)" == "Darwin" ]] && defaults read -g AppleInterfaceStyle &>/dev/null; then
    mode="dark"
elif [[ "$(uname -s)" == "Darwin" ]]; then
    mode="light"
else
    mode="dark"
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$state"

config="${XDG_CONFIG_HOME:-$HOME/.config}"

# --- State files (gitignored, read by tool configs via include) ---

# Delta: syntax-theme
if [[ "$mode" == "light" ]]; then
    delta_theme="Catppuccin Latte"
else
    delta_theme="Catppuccin Mocha"
fi
printf '[delta]\n    syntax-theme = %s\n' "$delta_theme" > "$state/delta-theme.gitconfig"

# Tmux: catppuccin flavor
if [[ "$mode" == "light" ]]; then
    tmux_flavor="latte"
else
    tmux_flavor="mocha"
fi
printf "set -g @catppuccin_flavor '%s'\n" "$tmux_flavor" > "$state/tmux-theme.conf"

# Starship: copy tracked config, swap palette
if [[ "$mode" == "light" ]]; then
    palette="catppuccin_latte"
else
    palette="catppuccin_mocha"
fi
if [[ -f "$config/starship.toml" ]]; then
    sed "s/^palette = .*/palette = '$palette'/" "$config/starship.toml" > "$state/starship.toml"
fi

# --- Live updates for running processes ---

# Tmux: apply without config reload
if command -v tmux >/dev/null 2>&1 && tmux list-sessions &>/dev/null; then
    tmux set -g @catppuccin_flavor "$tmux_flavor"
    tmux run '~/.tmux/plugins/tpm/tpm'
fi

# Borders: restart with correct colors
if command -v borders >/dev/null 2>&1; then
    if [[ "$mode" == "light" ]]; then
        active="0xff8839ef"   # catppuccin latte mauve
        inactive="0xffbcc0cc" # catppuccin latte surface1
    else
        active="0xffcba6f7"   # catppuccin mocha mauve
        inactive="0xff494d64" # catppuccin mocha surface1
    fi
    borders active_color="$active" inactive_color="$inactive" width=4.0 &>/dev/null &!
fi

# --- Export env vars (sourced by shell, not subshell) ---

# These only take effect when this script is sourced, not executed
export MY_THEME="$mode"

if command -v vivid >/dev/null 2>&1; then
    themes="$config/vivid/themes"
    if [[ "$mode" == "light" ]]; then
        export LS_COLORS="$(vivid generate "$themes/catppuccin-latte.yml")"
    else
        export LS_COLORS="$(vivid generate "$themes/catppuccin-mocha.yml")"
    fi
fi

if [[ "$mode" == "light" ]]; then
    export FZF_COLORS="bg+:#ccd0da,bg:#eff1f5,spinner:#dc8a78,hl:#d20f39,fg:#4c4f69,header:#d20f39,info:#8839ef,pointer:#dc8a78,marker:#dc8a78,fg+:#4c4f69,prompt:#8839ef,hl+:#d20f39"
    export BAT_THEME="Catppuccin Latte"
else
    export FZF_COLORS="bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8,fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc,marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8"
    export BAT_THEME="Catppuccin Mocha"
fi

# Re-export FZF_DEFAULT_OPTS with updated colors
export FZF_DEFAULT_OPTS="--height 60%
    --border rounded
    --layout reverse
    --color ${FZF_COLORS}
    --prompt '∷ '
    --pointer ▶
    --marker ⇒"
